{
  "name": "llm-host-local-server",
  "version": "1.0.4",
  "description": "A fully local AI chat app powered by Ollama and Express.js. Runs 100% on your PC — no internet required, no API costs, total privacy.",
  "main": "electron-main.cjs",
  "scripts": {
    "start": "node server.js",
    "start:electron": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:portable": "electron-builder --win portable --x64",
    "dist:installer": "electron-builder --win nsis --x64",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "ThilanKalhara",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "express": "^5.2.1",
    "multer": "^2.1.1",
    "ollama": "^0.6.3"
  },
  "devDependencies": {
    "electron": "^37.10.3",
    "electron-builder": "^26.18.0",
    "pkg": "^5.8.1"
  },
  "build": {
    "appId": "com.thilankalhara.localaiassistant",
    "productName": "Local AI Assistant",
    "copyright": "Copyright © 2026 ThilanKalhara",
    "files": [
      "electron-main.cjs",
      "server.js",
      "server.cjs",
      "public/**/*",
      "data/**/*",
      "uploads/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "icon": "icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Local AI Assistant",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico"
    }
  },
  "pkg": {
    "assets": [
      "public/**/*",
      "data/**/*",
      "uploads/**/*"
    ],
    "scripts": [
      "server.js"
    ]
  }
}
