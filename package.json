{
  "name": "llm-host-local-server",
  "version": "1.0.0",
  "description": "A fully local AI chat app powered by Ollama and Express.js. Runs 100% on your PC — no internet required, no API costs, total privacy.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dist": "pkg server.cjs --targets node18-win-x64 --output dist/LocalAIAssistant.exe",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "express": "^5.2.1",
    "multer": "^2.1.1",
    "ollama": "^0.6.3"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  },
  "pkg": {
    "assets": [
      "public/**/*",
      "data/**/*",
      "uploads/**/*"
    ],
    "scripts": [
      "server.js"
    ]
  }
}
